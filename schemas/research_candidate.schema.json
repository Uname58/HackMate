{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmate.local/schemas/research_candidate.schema.json",
  "title": "ResearchCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "task_id", "vulnerability_type", "title", "claim", "proposed_knowledge", "source_refs", "validation_plan", "status", "validation_evidence_refs", "validation_notes", "eval_ref", "approved_by", "promotion_ref", "rejection_reason", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "vulnerability_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "proposed_knowledge": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["proposed", "validated", "eval_passed", "approved", "rejected", "promoted"]},
    "validation_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "validation_notes": {"type": "string"},
    "eval_ref": {"type": ["string", "null"]},
    "approved_by": {"type": ["string", "null"]},
    "promotion_ref": {"type": ["string", "null"]},
    "rejection_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
