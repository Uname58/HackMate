{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmate.local/schemas/scope.schema.json",
  "title": "Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_id", "revision", "approved", "origins", "actions", "approval_source"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "approved": {"type": "boolean"},
    "origins": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "path_prefixes": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]}},
    "actions": {"type": "array", "items": {"enum": ["OBSERVE", "TEST", "IMPACT"]}},
    "max_requests": {"type": ["integer", "null"], "minimum": 0},
    "requests_per_minute": {"type": ["integer", "null"], "minimum": 1},
    "approval_source": {"type": "string", "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "allow_private_network": {"type": "boolean", "default": false},
    "impact_approved": {"type": "boolean", "default": false},
    "impact_actions": {"type": "array", "items": {"type": "string"}}
  }
}
