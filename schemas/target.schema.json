{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmate.local/schemas/target.schema.json",
  "title": "Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_id", "base_url"],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "base_url": {"type": "string", "format": "uri"},
    "label": {"type": ["string", "null"]},
    "environment": {"enum": ["local_lab", "staging", "production", "unknown"]},
    "authentication_context_ref": {"type": ["string", "null"]}
  }
}
