{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmate.local/schemas/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "created_at", "updated_at", "target", "scope", "budget", "user_request", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["CREATED", "VALIDATING_SCOPE", "RECON_RUNNING", "ANALYZE_RUNNING", "ATTACK_RUNNING", "REPORT_RUNNING", "COMPLETED", "PARTIAL", "BLOCKED", "FAILED", "CANCELLED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "user_request": {"type": "string"},
    "target": {"$ref": "target.schema.json"},
    "scope": {"$ref": "scope.schema.json"},
    "current_run_id": {"type": ["string", "null"]},
    "budget": {"type": "object", "additionalProperties": false, "properties": {"max_tokens": {"type": ["integer", "null"], "minimum": 0}, "max_duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "max_tool_calls": {"type": ["integer", "null"], "minimum": 0}, "max_retries": {"type": "integer", "minimum": 0, "default": 2}, "max_attack_rounds": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3}, "max_workflow_retries": {"type": "integer", "minimum": 0, "maximum": 3, "default": 1}}},
    "results": {"type": "object"},
    "results_history": {"type": "object"},
    "workflow_retry_count": {"type": "integer", "minimum": 0},
    "workflow_retry_active": {"type": "boolean"},
    "workflow_retry_next_stage": {"type": ["string", "null"]},
    "active_stage": {"type": ["string", "null"]},
    "active_stage_completed": {"type": "boolean"},
    "active_run_id": {"type": "string"},
    "budget_usage": {"type": "object", "additionalProperties": false, "required": ["tokens", "mode"], "properties": {"tokens": {"type": "integer", "minimum": 0}, "mode": {"enum": ["reported", "estimated"]}}},
    "scope_gate_state": {"type": "object", "additionalProperties": false, "required": ["total_requests", "recent_requests", "resolved_hosts"], "properties": {"total_requests": {"type": "integer", "minimum": 0}, "recent_requests": {"type": "array", "items": {"type": "number"}}, "resolved_hosts": {"type": "object"}}},
    "recovery_required": {"type": "boolean"},
    "interrupted_state": {"type": "string"},
    "resumed_at": {"type": "number"},
    "human_intervention_required": {"type": "boolean", "default": false}
  }
}
