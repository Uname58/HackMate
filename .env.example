# HackMate v2 配置（复制为 .env 填入）。优先级：环境变量 > .env > config.json > 默认值。

# 必填：API key（deepseek / openai / ollama 通用，OpenAI 兼容端点）
HACKMATE_API_KEY=sk-xxxx

# 可选：端点与模型
# HACKMATE_BASE_URL=https://api.deepseek.com/v1
# HACKMATE_MODEL=deepseek-chat          # 快模型：打靶场主对话 + 产 payload 判分 + 评委
# HACKMATE_SKILL_MODEL=deepseek-v4-pro  # 慢模型：读整份 skill 产改进候选（注意写全 v4-pro）

# 可选：CDP（浏览器调试端口）
# HACKMATE_CDP_HOST=localhost
# HACKMATE_CDP_PORT=9222

# Optional: JSON scope must be explicitly approved. Keep credentials out of this file.
# Local labs require allow_private_network=true and an exact localhost origin.
# HACKMATE_AUTHORIZED_SCOPE={"scope_id":"local-xss-lab","approved":true,"origins":["http://127.0.0.1:8080"],"path_prefixes":["/"],"methods":["GET"],"actions":["OBSERVE","TEST"],"approval_source":"user","allow_private_network":true}
